# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# Gmail credentials
EMAIL_ADDRESS=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Where to post the code: "interaction" (where the user ran /kod) or "channel" (to a fixed channel)
# Default: interaction
POST_DESTINATION=interaction

# Optional: Specific channel ID to post codes to (used when POST_DESTINATION=channel)
# If empty, bot will post to the channel where interraction occured
DISCORD_CHANNEL_ID=

# Netflix link expiry time in minutes
# Default: 15
NETFLINK_EXPIRY_MINUTES=15

# Cooldown (in seconds) between /kod command usages per user
KOD_COOLDOWN_SECONDS=10

# Gmail email subject to search for code (case-insensitive substring match)
# Default: Twój kod tymczasowego dostępu do serwisu Netflix
EMAIL_SUBJECT_CODE=Twój kod tymczasowego dostępu do serwisu Netflix