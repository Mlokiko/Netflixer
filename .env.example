# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# Where to post the code: "interaction" (where the user ran /kod) or "channel" (to a fixed channel)
# Default: interaction
POST_DESTINATION=interaction

# Specific channel ID to post codes to (used when POST_DESTINATION=channel)
# Optional: If empty, bot will post to the channel where interraction occured
DISCORD_CHANNEL_ID=

# Gmail credentials
EMAIL_ADDRESS=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Netflix link expiry time in minutes
# Default: 15
NETFLINK_EXPIRY_MINUTES=15

# Cooldown (in seconds) between /kod commands usages per user
# Default: 10
KOD_COOLDOWN_SECONDS=10

# Gmail email subject to search for temporary access code (case-insensitive substring match)
EMAIL_SUBJECT_TEMPORARY_CODE=Twój kod tymczasowego dostępu do serwisu Netflix

# Gmail email subject to search for login code (case-insensitive substring match)
EMAIL_SUBJECT_LOGIN_CODE=Netflix: kod logowania